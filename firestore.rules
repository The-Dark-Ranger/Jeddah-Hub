rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Normalize to lowercase so "Curator" / "curator" / "CURATOR" all match.
    // Also handle "impact officer" (space) alongside "impact_officer" (underscore).
    function userRole() {
      let raw = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return raw is string ? raw.lower() : '';
    }

    function isCurator() {
      return isSignedIn() && userRole() in ['curator', 'vice_curator'];
    }

    function isImpactOfficer() {
      return isSignedIn() && userRole() in ['impact_officer', 'impact officer'];
    }

    function isCuratorOrImpact() {
      return isCurator() || isImpactOfficer();
    }

    function isShaper() {
      return isSignedIn() && userRole() in ['shaper', 'alumni'];
    }

    function isAnyMember() {
      return isSignedIn() && userRole() in [
        'curator', 'vice_curator', 'impact_officer', 'impact officer',
        'shaper', 'alumni'
      ];
    }

    // ── users ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isCurator();
      allow delete: if isCurator();
    }

    // ── initiatives ───────────────────────────────────────────
    // Hub activities are stored here with type:'hub_activity'.
    // Public read. Curators create/update/delete all initiative docs.
    match /initiatives/{docId} {
      allow read: if true;
      allow create, update, delete: if isCurator();
    }

    // ── join_requests ─────────────────────────────────────────
    match /join_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if isOwner(resource.data.userId)
                    || isCuratorOrImpact();
      allow update: if isCuratorOrImpact();
      allow delete: if isOwner(resource.data.userId) || isCuratorOrImpact();
    }

    // ── blogs ─────────────────────────────────────────────────
    match /blogs/{docId} {
      allow read: if resource.data.status == 'published'
                  || (isSignedIn() && (
                       isCuratorOrImpact()
                       || request.auth.uid == resource.data.authorId
                     ));
      allow create: if isAnyMember();
      allow update: if isCuratorOrImpact()
                    || (isSignedIn()
                        && request.auth.uid == resource.data.authorId
                        && resource.data.status in ['draft', 'pending']);
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && request.auth.uid == resource.data.authorId);
    }

    // ── newsletter_subscribers ────────────────────────────────
    match /newsletter_subscribers/{docId} {
      allow create: if true;
      allow read, update, delete: if isCurator();
    }

    // ── impact_reports ────────────────────────────────────────
    match /impact_reports/{docId} {
      allow read: if true;
      allow create, update, delete: if isCuratorOrImpact();
    }

    // ── role_assignments ──────────────────────────────────────
    match /role_assignments/{docId} {
      allow read:   if isOwner(resource.data.uid) || isCurator();
      allow create: if isCurator();
      allow delete: if isCurator() || isOwner(resource.data.uid);
    }

    // ── contact_messages ──────────────────────────────────────
    match /contact_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isCurator();
    }

    // ── blog_likes ────────────────────────────────────────────
    match /blog_likes/{docId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    // ── blog_comments ─────────────────────────────────────────
    match /blog_comments/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.authorId || isCurator());
    }

    // ── notifications ─────────────────────────────────────────
    match /notifications/{docId} {
      allow read, update: if isCurator();
      allow create: if isSignedIn();
    }
  }
}
