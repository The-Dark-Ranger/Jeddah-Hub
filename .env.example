# Copy this file to .env.local and fill in the values. Never commit .env.local.
# In production these are set in the Vercel project settings.

# ── Firebase (Project settings → General → Your apps → Web app) ──
# These are public by design; access is controlled by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google reCAPTCHA v3 (protects the contact and newsletter forms) ──
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Resend (emails; jeddahhub.org is verified at resend.com/domains) ──
RESEND_API_KEY=
# Each kind of email has its own sender address on jeddahhub.org:
# Newsletter welcome (default newsletter@jeddahhub.org)
NEWSLETTER_EMAIL=
# Contact-form emails (default contact@jeddahhub.org)
CONTACT_EMAIL=
# Member invites, as "Name <address>" (default "Jeddah Hub <members@jeddahhub.org>")
FROM_EMAIL=
# Inbox that receives every contact-form message (replying answers the
# visitor). Defaults to jeddahglobalshapers@gmail.com.
CONTACT_INBOX=

# ── Site ──
# Canonical URL used for SEO metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.jeddahhub.org

# ── Firebase Admin (server only, never NEXT_PUBLIC) ──
# Lets curators create members' sign-in accounts (Role Assignments).
# Firebase console → Project settings → Service accounts → Generate new
# private key; paste the whole JSON file contents as one line.
FIREBASE_SERVICE_ACCOUNT=
