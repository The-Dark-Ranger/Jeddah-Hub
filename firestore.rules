rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Normalize to lowercase so "Curator"/"curator"/"CURATOR" all match.
    function userRole() {
      let raw = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return raw is string ? raw.lower() : '';
    }

    function isCurator() {
      return isSignedIn() && userRole() in ['curator', 'vice_curator', 'vice curator'];
    }

    // Accept both "impact_officer" (underscore) and "impact officer" (space).
    function isImpactOfficer() {
      return isSignedIn() && userRole() in ['impact_officer', 'impact officer'];
    }

    function isCuratorOrImpact() {
      return isCurator() || isImpactOfficer();
    }

    function isShaper() {
      return isSignedIn() && userRole() in ['shaper', 'alumni'];
    }

    function isAnyMember() {
      return isSignedIn() && userRole() in ['curator', 'vice_curator', 'vice curator', 'impact_officer', 'impact officer', 'shaper', 'alumni'];
    }

    // Is the caller a lead of the given initiative? Used to scope
    // leave_requests/removal_requests actions to that specific
    // initiative's leads rather than any signed-in member.
    function isLeadOf(initiativeId) {
      return isSignedIn()
             && 'leads' in get(/databases/$(database)/documents/initiatives/$(initiativeId)).data
             && request.auth.uid in get(/databases/$(database)/documents/initiatives/$(initiativeId)).data.leads;
    }

    // Does the given role_assignments doc belong to the caller? These docs
    // never carry a `uid` field (the invitee doesn't have an account yet
    // when a curator creates one), so ownership is decided by matching the
    // caller's own verified auth email against the doc's `email` field.
    function isAssignee(data) {
      return isSignedIn() && request.auth.token.email != null
             && request.auth.token.email.lower() == data.email;
    }

    // A curator-created role_assignments doc keyed by the caller's own
    // verified auth email (see role_assignments below — assignments are
    // created with the lowercased email as the doc ID specifically so
    // this can look them up directly). Lets a freshly-invited user apply
    // ANY pre-assigned role — including curator/vice_curator/impact_officer
    // — to their own account on first login, without opening up
    // self-escalation: the only way a role_assignments doc can exist at
    // all is isCurator() creating one (see below), so this just lets the
    // invitee redeem a grant a curator already made, not invent one.
    function preassignedRole() {
      return (isSignedIn() && request.auth.token.email != null
              && exists(/databases/$(database)/documents/role_assignments/$(request.auth.token.email.lower())))
             ? get(/databases/$(database)/documents/role_assignments/$(request.auth.token.email.lower())).data.role
             : null;
    }

    // ── users ─────────────────────────────────────────────────
    // Private — contains `email`, which must never be bulk-readable. Only
    // the owner or a curator/impact officer may read a given user's full
    // doc; public-facing pages (About/shapers, homepage, project member
    // lists) instead read the public_profiles mirror below, which never
    // has an email field. See public_profiles for why this split exists.
    // Users write only their own doc, but may never self-assign a
    // privileged role out of thin air — only an existing curator can
    // grant curator/vice_curator/impact_officer, UNLESS the value being
    // written exactly matches a role a curator already pre-assigned to
    // this account's own email via role_assignments (preassignedRole()).
    // Without either guard, any signed-in user could call
    // updateDoc(users/{ownUid}, {role:'curator'}) directly via the SDK
    // and grant themselves admin access, since every
    // isCurator()/isImpactOfficer() check in this file reads straight
    // from this field. Note this read restriction does NOT break those
    // checks — get()/exists() in rules always succeed server-side
    // regardless of the caller's read permission on the target doc.
    match /users/{uid} {
      allow read: if isOwner(uid) || isCuratorOrImpact();
      allow create: if isOwner(uid)
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == null
                        || request.resource.data.role in ['shaper', 'alumni']
                        || request.resource.data.role == preassignedRole());
      allow update: if isCurator()
                    || (isOwner(uid)
                        && (request.resource.data.role == resource.data.role
                            || request.resource.data.role in ['shaper', 'alumni']
                            || request.resource.data.role == preassignedRole()));
      allow delete: if isCurator();
    }

    // ── public_profiles ───────────────────────────────────────
    // A deliberately narrow mirror of users/{uid}, kept in sync by the app
    // (src/lib/auth.ts, shaper/profile page) whenever the owner's public
    // fields change. Publicly readable by design (About/shapers pages,
    // homepage, project member lists) — hasOnly() below is the actual
    // security boundary: `email` is structurally never a legal key here,
    // so even a compromised client can't smuggle it in via a direct write.
    match /public_profiles/{uid} {
      allow read: if true;
      allow write: if (isOwner(uid) || isCurator())
                   && request.resource.data.keys().hasOnly(
                        ['displayName', 'displayNameAr', 'photoURL', 'bio',
                         'linkedin', 'twitter', 'instagram', 'role']);
    }

    // ── initiatives ───────────────────────────────────────────
    // Public can read. Curators and impact officers can create/update
    // (the impact/projects dashboard page is impact officers' primary
    // tool for managing projects — create, archive/restore, assign
    // members — so they need the same access curators have here; hard
    // delete stays curator-only since the impact officer UI never
    // exposes it). Initiative leads (UIDs in the `leads` array) can edit
    // their own initiative's content fields and its `members` array
    // (accepting join requests, removing members — the shaper/initiatives
    // dashboard's lead tools need this) — but never `status` or the
    // `leads` array itself, which would let a lead self-promote arbitrary
    // co-leads or remove others via a raw write. Note `members[].role` is
    // a display-only string (e.g. "Lead" badge text); actual lead
    // privilege is only ever granted through the separate `leads` field,
    // so a lead editing that text doesn't grant themselves anything new.
    match /initiatives/{docId} {
      allow read: if true;
      allow create: if isCuratorOrImpact();
      allow delete: if isCurator();
      allow update: if isCuratorOrImpact()
                    || (isSignedIn()
                        && 'leads' in resource.data
                        && request.auth.uid in resource.data.leads
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly([
                               'title', 'titleAr', 'description', 'descriptionAr',
                               'category', 'startDate', 'endDate',
                               'imageUrl', 'images', 'stat', 'problem', 'objective',
                               'impact', 'impactAreas', 'color', 'members',
                             ]));
    }

    // ── join_requests ─────────────────────────────────────────
    // Shapers create requests for themselves.
    // Curators, impact officers, and that specific initiative's leads can
    // read/update/delete — update is scoped to only the `status` field so
    // a lead can't rewrite anything else on the request doc.
    match /join_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if isOwner(resource.data.userId)
                    || isCuratorOrImpact()
                    || isLeadOf(resource.data.initiativeId);
      allow update: if isCuratorOrImpact()
                    || (isLeadOf(resource.data.initiativeId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isOwner(resource.data.userId)
                    || isCuratorOrImpact()
                    || isLeadOf(resource.data.initiativeId);
    }

    // ── initiative_requests ──────────────────────────────────
    // Any member can propose a new initiative for curator/impact-officer
    // review — same shape as join_requests/leave_requests above. Proposer
    // can only create as themselves and must start pending (no self-
    // approval); update is curator/impact-officer-only and field-capped to
    // just the review outcome, since only the curator side ever performs
    // an approve/decline — the proposal's own content is never edited in
    // place. Approval creates a real initiatives doc separately (governed
    // by the initiatives rules above, not this collection).
    match /initiative_requests/{docId} {
      allow create: if isAnyMember()
                    && request.resource.data.proposedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
      allow update: if isCuratorOrImpact()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
    }

    // ── activity_requests ──────────────────────────────────────
    // Same shape as initiative_requests, for a lead proposing a Hub
    // Activity/workshop instead of a whole new initiative — curator or
    // vice_curator/impact_officer review turns an approved one into a
    // real initiatives doc tagged type:'hub_activity' (governed by the
    // initiatives rules above, not this collection).
    match /activity_requests/{docId} {
      allow create: if isAnyMember()
                    && request.resource.data.proposedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read:   if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
      allow update: if isCuratorOrImpact()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
    }

    // ── blogs ─────────────────────────────────────────────────
    // Published posts are publicly readable.
    // Any authenticated member can create (status will be 'draft' or 'pending').
    // Curators can read/write all. Authors can read/edit their own draft/pending.
    match /blogs/{docId} {
      allow read: if resource.data.status == 'published'
                  || (isSignedIn() && (
                       isCuratorOrImpact()
                       || request.auth.uid == resource.data.authorId
                     ));
      // authorId must be the writer's own uid (no impersonation), and only
      // curators/impact officers may create a post already in 'published' —
      // everyone else's direct writes are capped at draft/pending_review
      // regardless of what the client UI offers, since that's a
      // client-only signal with nothing server-side to verify it.
      allow create: if isAnyMember()
                    && request.resource.data.authorId == request.auth.uid
                    && (isCuratorOrImpact()
                        || request.resource.data.status in ['draft', 'pending_review']);
      allow update: if isCuratorOrImpact()
                    // Authors may only edit their own still-unpublished post, and only
                    // into another unpublished status — otherwise a self-write could flip
                    // status straight to 'published' (bypassing curator review) or hijack
                    // authorId, neither of which the precondition on resource.data alone
                    // would catch since that only looks at the doc's state *before* the write.
                    || (isSignedIn()
                        && request.auth.uid == resource.data.authorId
                        && resource.data.status in ['draft', 'pending_review']
                        && request.resource.data.authorId == resource.data.authorId
                        && request.resource.data.status in ['draft', 'pending_review'])
                    // Likes: anyone (including anonymous visitors) may toggle only the
                    // likedBy/visitorLikes fields on a published post — needed because
                    // guest likes are written with no Firebase Auth session at all.
                    || (resource.data.status == 'published'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['likedBy', 'visitorLikes']));
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && request.auth.uid == resource.data.authorId);
    }

    // ── newsletter_subscribers ────────────────────────────────
    // Anyone can subscribe. Only curators can read the list.
    match /newsletter_subscribers/{docId} {
      allow create: if true;
      allow read, update, delete: if isCurator();
    }

    // ── impact_reports ────────────────────────────────────────
    // Public can read. Curator/vice_curator only — the impact/reports
    // dashboard page is no longer part of the impact officer's tools
    // (see dashboard/layout.tsx), so this matches that UI-level
    // restriction instead of leaving it enforceable only cosmetically.
    match /impact_reports/{docId} {
      allow read: if true;
      allow create, update, delete: if isCurator();
    }

    // ── role_assignments ──────────────────────────────────────
    // Curators create/delete. Ownership is by email match (isAssignee()
    // above) since these docs never carry a `uid` field. The assignee
    // needs read access to their own pending assignment so the client can
    // discover what role to self-apply on first login (src/lib/auth.ts,
    // lookupRoleAssignment) — without it that lookup silently returns
    // nothing and no role, not even shaper/alumni, is ever applied.
    // Deliberately no `update` rule: marking an assignment "joined" for a
    // curator-facing notification is intentionally not supported.
    match /role_assignments/{docId} {
      allow read:   if isAssignee(resource.data) || isCuratorOrImpact();
      allow create: if isCurator();
      allow delete: if isCurator() || isAssignee(resource.data);
    }

    // ── contact_messages ──────────────────────────────────────
    // Anyone can submit (the reCAPTCHA check on the contact form is
    // client-side only — Firestore rules can't verify a token — so this
    // caps what a direct SDK write can contain instead: no extra/spoofed
    // fields like a pre-set `read:true`, and bounded string sizes so the
    // form can't be used to write arbitrarily large documents). Only
    // curators can read + manage.
    match /contact_messages/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'submittedAt', 'read'])
                    && request.resource.data.read == false
                    && request.resource.data.name is string    && request.resource.data.name.size()    <= 200
                    && request.resource.data.subject is string && request.resource.data.subject.size() <= 300
                    && request.resource.data.message is string && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isCurator();
    }

    // ── activity_responses ───────────────────────────────────
    // Hub Activities' custom-form submissions. Public create (activities
    // are open community events, not member-only, matching
    // contact_messages' precedent for unauthenticated public submissions)
    // — `answers` can't be validated more granularly than "is a map" since
    // each activity's question set is curator-defined and dynamic, unlike
    // contact_messages' fixed fields. Reads are curator/impact-officer
    // only so individual respondents' answers are never publicly listable,
    // only the activity doc itself (which never contains responses) is.
    // `read` starts false (contact_messages' pattern) and update is capped
    // to just that field, so opening the "View Responses" modal can mark
    // them seen without a curator write being able to touch anything else.
    match /activity_responses/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['activityId', 'answers', 'submittedAt', 'submitterName', 'submitterEmail', 'read'])
                    && request.resource.data.activityId is string
                    && request.resource.data.answers is map
                    && request.resource.data.submittedAt is string
                    && request.resource.data.read == false;
      allow read, delete: if isCuratorOrImpact();
      allow update: if isCuratorOrImpact()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ── blog_likes ────────────────────────────────────────────
    // Any signed-in user can like/unlike. Public can read counts.
    match /blog_likes/{docId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    // ── blog_comments ─────────────────────────────────────────
    // Public can read. Signed-in users can add as themselves only —
    // authorId must match the writer's own uid, or anyone could post a
    // comment impersonating another member (e.g. a curator) via a raw
    // SDK call. Authors and curators can delete.
    match /blog_comments/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.authorId || isCurator());
    }

    // ── notifications ─────────────────────────────────────────
    // Signed-in users can create. Only curators can read and update.
    // Field-capped to the exact shape dashboard/impact/projects writes, so
    // a raw SDK call can't smuggle extra fields into what a curator later
    // reads and trusts.
    match /notifications/{docId} {
      allow read, update: if isCurator();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(
                         ['type', 'initiativeId', 'initiativeTitle', 'fromUserId',
                          'fromUserName', 'toEmail', 'message', 'read', 'createdAt']);
    }

    // ── leave_requests ─────────────────────────────────────────
    // Members request to leave their own initiative.
    // Curators, impact officers, and that specific initiative's leads can
    // manage it — update is scoped to only the `status` field so a lead
    // can't rewrite anything else on the request doc.
    match /leave_requests/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId)
                  || isCuratorOrImpact()
                  || isLeadOf(resource.data.initiativeId);
      allow update: if isCuratorOrImpact()
                    || (isLeadOf(resource.data.initiativeId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isOwner(resource.data.userId) || isCuratorOrImpact();
    }

    // ── removal_requests ────────────────────────────────────────
    // Initiative leads submit removal requests for members — create
    // requires the caller to actually be a lead of that initiative
    // (otherwise any signed-in member could spam removal requests
    // targeting arbitrary users in initiatives they have no relation to).
    // Curators and impact officers review and approve/decline.
    match /removal_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.requestedByUserId == request.auth.uid
                    && isLeadOf(request.resource.data.initiativeId);
      allow read: if isCuratorOrImpact()
                  || isOwner(resource.data.requestedByUserId);
      allow update: if isCuratorOrImpact();
      allow delete: if isOwner(resource.data.requestedByUserId) || isCuratorOrImpact();
    }

    // ── member_add_requests ──────────────────────────────────────
    // Mirror of removal_requests: an initiative lead can invite someone
    // who hasn't already submitted their own join_request, but — same as
    // removal — can't unilaterally add them; a curator/impact officer
    // reviews and approves/declines before the target actually lands in
    // the initiative's `members` array.
    match /member_add_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.requestedByUserId == request.auth.uid
                    && isLeadOf(request.resource.data.initiativeId);
      allow read: if isCuratorOrImpact()
                  || isOwner(resource.data.requestedByUserId);
      allow update: if isCuratorOrImpact();
      allow delete: if isOwner(resource.data.requestedByUserId) || isCuratorOrImpact();
    }
  }
}
