rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Cross-service rule: Storage has no direct visibility into Firestore, so
    // the role check firestore.rules applies to /users/{uid}.role is
    // duplicated here via firestore.get(). Keep both in sync if the role
    // model changes.
    function userRole() {
      let raw = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
      return raw is string ? raw.lower() : '';
    }

    function isCuratorOrImpact() {
      return isSignedIn() && userRole() in [
        'curator', 'vice_curator', 'vice curator', 'impact_officer', 'impact officer'
      ];
    }

    // ── impact_reports/{reportId}/{fileName} ────────────────────
    // PDF impact reports. Public read (downloadable from the public site,
    // mirrors the impact_reports Firestore collection's read rule). Only
    // curators, vice curators, and impact officers can upload or replace one,
    // capped at 25 MB and restricted to actual PDFs.
    match /impact_reports/{reportId}/{fileName} {
      allow read: if true;
      allow create, update: if isCuratorOrImpact()
                            && request.resource.size < 25 * 1024 * 1024
                            && request.resource.contentType == 'application/pdf';
      allow delete: if isCuratorOrImpact();
    }

    // Default deny — explicit for clarity; unmatched paths are already
    // denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
