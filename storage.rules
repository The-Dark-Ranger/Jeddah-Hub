rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Initiative photos: any signed-in user can read; only signed-in users can upload
    match /initiatives/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // User avatars: public read; user can write their own
    match /users/{userId}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
