rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Normalize to lowercase so "Curator"/"curator"/"CURATOR" all match.
    function userRole() {
      let raw = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return raw is string ? raw.lower() : '';
    }

    function isCurator() {
      return isSignedIn() && userRole() in ['curator', 'vice_curator', 'vice curator'];
    }

    // Accept both "impact_officer" (underscore) and "impact officer" (space).
    function isImpactOfficer() {
      return isSignedIn() && userRole() in ['impact_officer', 'impact officer'];
    }

    function isCuratorOrImpact() {
      return isCurator() || isImpactOfficer();
    }

    function isShaper() {
      return isSignedIn() && userRole() in ['shaper', 'alumni'];
    }

    function isAnyMember() {
      return isSignedIn() && userRole() in ['curator', 'vice_curator', 'vice curator', 'impact_officer', 'impact officer', 'shaper', 'alumni'];
    }

    // Is the caller a lead of the given initiative? Used to scope
    // leave_requests/removal_requests actions to that specific
    // initiative's leads rather than any signed-in member.
    function isLeadOf(initiativeId) {
      return isSignedIn()
             && 'leads' in get(/databases/$(database)/documents/initiatives/$(initiativeId)).data
             && request.auth.uid in get(/databases/$(database)/documents/initiatives/$(initiativeId)).data.leads;
    }

    // The Curator specifically (not a vice curator).
    function isFullCurator() {
      return isSignedIn() && userRole() == 'curator';
    }

    // A users/ or public_profiles/ doc with no role assigned yet.
    function hasNoRole(d) {
      return d.get('role', null) == null || d.get('role', null) == '';
    }

    // Curators and vice curators edit member records, but only the Curator
    // can change a curator's record or hand out the curator role.
    function curatorMayEdit(before, after) {
      return isFullCurator()
             || (before.get('role', '') != 'curator' && after.get('role', '') != 'curator');
    }

    // Size/type limits on the profile fields members and curators write.
    function optStr(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }
    // A user-entered link: empty, or an http(s) URL (never javascript:, data:, …).
    function optUrl(d, key) {
      return !(key in d) || d[key] == null || d[key] == ''
             || (d[key] is string && d[key].size() <= 500 && d[key].matches('^https?://[^\\s]+$'));
    }
    function validProfile(d) {
      return optStr(d, 'displayName', 100) && optStr(d, 'displayNameAr', 100)
             && optStr(d, 'bio', 5000) && optStr(d, 'bioAr', 5000)
             && optUrl(d, 'linkedin') && optUrl(d, 'twitter') && optUrl(d, 'instagram')
             // Photos may be stored inline as a compressed data URI.
             && optStr(d, 'photoURL', 1000000);
    }

    // ── Anti-spoofing ──
    // Names and emails shown to curators on requests, notifications and
    // posts must be the caller's own: the name saved on their profile (or
    // their sign-in email), never someone else's.
    function isMyName(n) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return n is string && n.size() > 0 && n.size() <= 120
             && (n == me.get('displayName', '') || n == me.get('displayNameAr', '')
                 || (request.auth.token.email != null && n.lower() == request.auth.token.email.lower()));
    }
    function isMyEmail(e) {
      return e is string && request.auth.token.email != null
             && e.lower() == request.auth.token.email.lower();
    }
    // A new request always starts pending (no self-approval).
    function isNewRequest(d) {
      return d.status == 'pending' && d.get('requestedAt', '') is string;
    }
    // An initiative id that names a real initiative.
    function isInitiative(id) {
      return id is string && id.size() > 0 && id.size() <= 128
             && exists(/databases/$(database)/documents/initiatives/$(id));
    }
    function isRealRole(r) {
      return r in ['curator', 'vice_curator', 'impact_officer', 'shaper', 'alumni'];
    }

    // Does the given role_assignments doc belong to the caller? These docs
    // never carry a `uid` field (the invitee doesn't have an account yet
    // when a curator creates one), so ownership is decided by matching the
    // caller's own verified auth email against the doc's `email` field.
    function isAssignee(data) {
      return isSignedIn() && request.auth.token.email != null
             && request.auth.token.email.lower() == data.email;
    }

    // A curator-created role_assignments doc keyed by the caller's own
    // verified auth email (see role_assignments below — assignments are
    // created with the lowercased email as the doc ID specifically so
    // this can look them up directly). Lets a freshly-invited user apply
    // ANY pre-assigned role — including curator/vice_curator/impact_officer
    // — to their own account on first login, without opening up
    // self-escalation: the only way a role_assignments doc can exist at
    // all is isCurator() creating one (see below), so this just lets the
    // invitee redeem a grant a curator already made, not invent one.
    function preassignedRole() {
      return (isSignedIn() && request.auth.token.email != null
              && exists(/databases/$(database)/documents/role_assignments/$(request.auth.token.email.lower())))
             ? get(/databases/$(database)/documents/role_assignments/$(request.auth.token.email.lower())).data.role
             : null;
    }

    // ── users ─────────────────────────────────────────────────
    // Private — contains `email`, which must never be bulk-readable. Only
    // the owner or a curator/impact officer may read a given user's full
    // doc; public-facing pages (About/shapers, homepage, project member
    // lists) instead read the public_profiles mirror below, which never
    // has an email field. See public_profiles for why this split exists.
    // Users write only their own doc, but may never self-assign a
    // privileged role out of thin air — only an existing curator can
    // grant curator/vice_curator/impact_officer, UNLESS the value being
    // written exactly matches a role a curator already pre-assigned to
    // this account's own email via role_assignments (preassignedRole()).
    // Without either guard, any signed-in user could call
    // updateDoc(users/{ownUid}, {role:'curator'}) directly via the SDK
    // and grant themselves admin access, since every
    // isCurator()/isImpactOfficer() check in this file reads straight
    // from this field. Note this read restriction does NOT break those
    // checks — get()/exists() in rules always succeed server-side
    // regardless of the caller's read permission on the target doc.
    //
    // Hardened: a member's only role ever comes from a curator, either
    // written by the server when their account is created
    // (/api/members/create-account) or via the role_assignments grant for
    // their own email. A member can no longer give themselves 'shaper' or
    // 'alumni', change their role once they have one, or touch their uid,
    // email or createdAt — only the profile fields My Profile edits, with
    // size limits. Only the Curator (not a vice curator) can change or
    // remove a curator's record, or make someone a curator.
    match /users/{uid} {
      allow read: if isOwner(uid) || isCuratorOrImpact();
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'email', 'role', 'createdAt', 'displayName', 'displayNameAr',
                          'photoURL', 'bio', 'bioAr', 'linkedin', 'twitter', 'instagram'])
                    && request.resource.data.get('uid', uid) == uid
                    && (!('email' in request.resource.data)
                        || (request.auth.token.email != null
                            && request.resource.data.email is string
                            && request.resource.data.email.lower() == request.auth.token.email.lower()))
                    && (hasNoRole(request.resource.data) || request.resource.data.role == preassignedRole())
                    && validProfile(request.resource.data);
      // A curator's role change must be to a real role; uid and email never change.
      allow update: if (isCurator() && curatorMayEdit(resource.data, request.resource.data)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email'])
                        && (request.resource.data.get('role', null) == resource.data.get('role', null)
                            || hasNoRole(request.resource.data) || isRealRole(request.resource.data.role))
                        && validProfile(request.resource.data))
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                             ['displayName', 'displayNameAr', 'photoURL', 'bio', 'bioAr',
                              'linkedin', 'twitter', 'instagram', 'role'])
                        && (request.resource.data.get('role', null) == resource.data.get('role', null)
                            || (hasNoRole(resource.data) && request.resource.data.role == preassignedRole()))
                        && validProfile(request.resource.data));
      allow delete: if isCurator() && (isFullCurator() || resource.data.get('role', '') != 'curator');
    }

    // ── public_profiles ───────────────────────────────────────
    // A deliberately narrow mirror of users/{uid}, kept in sync by the app
    // (src/lib/auth.ts, shaper/profile page) whenever the owner's public
    // fields change. Publicly readable by design (About/shapers pages,
    // homepage, project member lists) — hasOnly() below is the actual
    // security boundary: `email` is structurally never a legal key here,
    // so even a compromised client can't smuggle it in via a direct write.
    // `role` is display-only text on this doc (real privilege only ever
    // comes from users/{uid}.role), but it's also what the public "Who We
    // Are" page's curator/shaper listings query directly — so an owner's
    // self-write still can't set it to anything other than what's already
    // there or what their real, protected users/{uid}.role says, closing
    // off a self-promotion-for-display attack even though it grants no
    // actual access.
    match /public_profiles/{uid} {
      allow read: if true;
      allow create, update: if (isOwner(uid) || isCurator())
                   && request.resource.data.keys().hasOnly(
                        ['displayName', 'displayNameAr', 'photoURL', 'bio', 'bioAr',
                         'linkedin', 'twitter', 'instagram', 'role'])
                   && validProfile(request.resource.data)
                   && (isCurator()
                       || !('role' in request.resource.data)
                       || (resource != null && request.resource.data.role == resource.data.role)
                       || request.resource.data.role == userRole());
      allow delete: if isCurator();
    }

    // ── initiatives ───────────────────────────────────────────
    // Public can read. Curators and impact officers can create/update
    // (the impact/projects dashboard page is impact officers' primary
    // tool for managing projects — create, archive/restore, assign
    // members — so they need the same access curators have here; hard
    // delete stays curator-only since the impact officer UI never
    // exposes it). Initiative leads (UIDs in the `leads` array) can edit
    // their own initiative's content fields and its `members` array
    // (accepting join requests, removing members — the shaper/initiatives
    // dashboard's lead tools need this) — but never `status` or the
    // `leads` array itself, which would let a lead self-promote arbitrary
    // co-leads or remove others via a raw write. Note `members[].role` is
    // a display-only string (e.g. "Lead" badge text); actual lead
    // privilege is only ever granted through the separate `leads` field,
    // so a lead editing that text doesn't grant themselves anything new.
    // `featured`/`featuredAt` pick what the homepage's Featured
    // Initiatives section shows — a curatorship decision, so impact
    // officers (who can otherwise edit initiatives) can't set them.
    match /initiatives/{docId} {
      allow read: if true;
      // Every write: an activity's button link must be a real http(s) URL.
      allow create: if optUrl(request.resource.data, 'ctaUrl')
                    && (isCurator()
                        || (isImpactOfficer() && request.resource.data.get('featured', false) != true));
      allow delete: if isCurator();
      allow update: if optUrl(request.resource.data, 'ctaUrl') && (isCurator()
                    || (isImpactOfficer()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['featured', 'featuredAt']))
                    || (isSignedIn()
                        && 'leads' in resource.data
                        && request.auth.uid in resource.data.leads
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly([
                               'title', 'titleAr', 'description', 'descriptionAr',
                               'category', 'startDate', 'endDate',
                               'imageUrl', 'images', 'stat', 'problem', 'objective',
                               'impact', 'impactAreas', 'color', 'members', 'slug',
                             ])));
    }

    // ── join_requests ─────────────────────────────────────────
    // Shapers create requests for themselves.
    // Curators, impact officers, and that specific initiative's leads can
    // read/update/delete — update is scoped to only the `status` field so
    // a lead can't rewrite anything else on the request doc.
    match /join_requests/{docId} {
      // Only as yourself (your own uid, email and name), pending, for a real initiative.
      allow create: if isAnyMember()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['initiativeId', 'userId', 'userEmail', 'userName', 'status', 'requestedAt'])
                    && isNewRequest(request.resource.data)
                    && isInitiative(request.resource.data.initiativeId)
                    && isMyEmail(request.resource.data.userEmail)
                    && isMyName(request.resource.data.userName);
      allow read:   if isOwner(resource.data.userId)
                    || isCuratorOrImpact()
                    || isLeadOf(resource.data.initiativeId);
      allow update: if isCuratorOrImpact()
                    || (isLeadOf(resource.data.initiativeId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isOwner(resource.data.userId)
                    || isCuratorOrImpact()
                    || isLeadOf(resource.data.initiativeId);
    }

    // ── initiative_requests ──────────────────────────────────
    // Any member can propose a new initiative for curator/impact-officer
    // review — same shape as join_requests/leave_requests above. Proposer
    // can only create as themselves and must start pending (no self-
    // approval); update is curator/impact-officer-only and field-capped to
    // just the review outcome, since only the curator side ever performs
    // an approve/decline — the proposal's own content is never edited in
    // place. Approval creates a real initiatives doc separately (governed
    // by the initiatives rules above, not this collection).
    match /initiative_requests/{docId} {
      allow create: if isAnyMember()
                    && request.resource.data.proposedBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(
                         ['title', 'titleAr', 'description', 'descriptionAr', 'category', 'startDate', 'endDate',
                          'imageUrl', 'images', 'stat', 'problem', 'objective', 'impact', 'impactAreas', 'color',
                          'proposedBy', 'proposedByName', 'status', 'requestedAt'])
                    && isMyName(request.resource.data.proposedByName)
                    && optStr(request.resource.data, 'title', 300)
                    && optStr(request.resource.data, 'description', 10000)
                    && optStr(request.resource.data, 'descriptionAr', 10000);
      allow read:   if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
      allow update: if isCuratorOrImpact()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
    }

    // ── activity_requests ──────────────────────────────────────
    // Same shape as initiative_requests, for a lead proposing a Hub
    // Activity/workshop instead of a whole new initiative — curator or
    // vice_curator/impact_officer review turns an approved one into a
    // real initiatives doc tagged type:'hub_activity' (governed by the
    // initiatives rules above, not this collection).
    match /activity_requests/{docId} {
      allow create: if isAnyMember()
                    && request.resource.data.proposedBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(
                         ['title', 'kind', 'eyebrow', 'subtitle', 'description', 'date', 'location',
                          'ctaText', 'ctaUrl', 'proposedBy', 'proposedByName', 'status', 'requestedAt'])
                    && optUrl(request.resource.data, 'ctaUrl')
                    && isMyName(request.resource.data.proposedByName);
      allow read:   if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
      allow update: if isCuratorOrImpact()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
    }

    // ── activity_change_requests ────────────────────────────────
    // Lets an initiative's leads manage Hub Activities without being able
    // to write to the live `initiatives` collection directly — every
    // create/edit/archive action lands here as a pending request instead,
    // and only a curator/vice_curator/impact_officer applying it (via the
    // existing isCuratorOrImpact() create/update rules on `initiatives`
    // above) makes it real. `payload` carries whatever activity fields are
    // being proposed (the full form for a create/edit, or just e.g.
    // {archived: true} for a one-click archive) — like
    // activity_responses.answers, its inner keys aren't validated here
    // since the shape is open-ended; the approval code applies an explicit
    // field allowlist before writing it to `initiatives`, so a malicious
    // payload can smuggle nothing past that even if a curator blindly
    // approves.
    //
    // A request must name the specific initiative (`initiativeId`) that
    // makes the requester eligible, checked the same way
    // leave_requests/removal_requests already scope a lead's write to
    // "an initiative they actually lead" (isLeadOf()) — for a 'create'
    // that's just whichever led initiative the lead is proposing the
    // activity for; for an 'update' it must additionally match the
    // *target* activity's own recorded initiativeId, so a lead can't
    // relabel someone else's activity as belonging to an initiative they
    // lead just to pass the isLeadOf() check.
    match /activity_change_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.proposedBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.changeType in ['create', 'update']
                    && isLeadOf(request.resource.data.initiativeId)
                    && (request.resource.data.changeType == 'create'
                        || (request.resource.data.activityId is string
                            && get(/databases/$(database)/documents/initiatives/$(request.resource.data.activityId)).data.initiativeId
                               == request.resource.data.initiativeId))
                    && request.resource.data.payload is map
                    && request.resource.data.keys().hasOnly(
                         ['changeType', 'activityId', 'initiativeId', 'activityTitle', 'payload',
                          'proposedBy', 'proposedByName', 'status', 'requestedAt'])
                    && isMyName(request.resource.data.proposedByName)
                    && optStr(request.resource.data, 'activityTitle', 300);
      allow read:   if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid);
      allow update: if isCuratorOrImpact()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && resource.data.proposedBy == request.auth.uid && resource.data.status == 'pending');
    }

    // A like list changed by at most one entry: unchanged, one added, or one removed.
    function oneLikeStep(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      return after == before
             || (after.size() == before.size() + 1 && after.hasAll(before))
             || (after.size() == before.size() - 1 && before.hasAll(after));
    }

    // The only likedBy entry added or removed is the caller's own uid
    // (none at all for a signed-out visitor).
    function ownLikeOnly() {
      let before = resource.data.get('likedBy', []).toSet();
      let after = request.resource.data.get('likedBy', []).toSet();
      return after.difference(before).union(before.difference(after))
               .hasOnly(request.auth == null ? [] : [request.auth.uid]);
    }

    // ── blogs ─────────────────────────────────────────────────
    // Published posts are publicly readable.
    // Any authenticated member can create (status will be 'draft' or 'pending').
    // Curators can read/write all. Authors can read/edit their own draft/pending.
    match /blogs/{docId} {
      allow read: if resource.data.status == 'published'
                  || (isSignedIn() && (
                       isCuratorOrImpact()
                       || request.auth.uid == resource.data.authorId
                     ));
      // authorId must be the writer's own uid (no impersonation), and only
      // curators/impact officers may create a post already in 'published' —
      // everyone else's direct writes are capped at draft/pending_review
      // regardless of what the client UI offers, since that's a
      // client-only signal with nothing server-side to verify it.
      // authorRole is shown on the post ("Curator", "Global Shaper"), so it
      // must be the author's real role, not whatever the client sends.
      allow create: if isAnyMember()
                    && request.resource.data.authorId == request.auth.uid
                    && (!('authorRole' in request.resource.data)
                        || (request.resource.data.authorRole is string
                            && request.resource.data.authorRole.lower().replace(' ', '_') == userRole().replace(' ', '_')))
                    // The byline is the author's own name, not someone else's.
                    && (!('authorName' in request.resource.data) || isMyName(request.resource.data.authorName))
                    && optStr(request.resource.data, 'title', 300)
                    && (isCuratorOrImpact()
                        || request.resource.data.status in ['draft', 'pending_review']);
      allow update: if isCuratorOrImpact()
                    // Authors may only edit their own still-unpublished post, and only
                    // into another unpublished status — otherwise a self-write could flip
                    // status straight to 'published' (bypassing curator review) or hijack
                    // authorId, neither of which the precondition on resource.data alone
                    // would catch since that only looks at the doc's state *before* the write.
                    || (isSignedIn()
                        && request.auth.uid == resource.data.authorId
                        && resource.data.status in ['draft', 'pending_review']
                        && request.resource.data.authorId == resource.data.authorId
                        && request.resource.data.get('authorRole', '') == resource.data.get('authorRole', '')
                        && request.resource.data.get('authorName', '') == resource.data.get('authorName', '')
                        && request.resource.data.status in ['draft', 'pending_review'])
                    // Likes: anyone (including anonymous visitors) may toggle only the
                    // likedBy/visitorLikes fields on a published post — needed because
                    // guest likes are written with no Firebase Auth session at all.
                    // Each write may add or remove a single like (what the page's
                    // arrayUnion/arrayRemove does), and a signed-in like only as the
                    // caller's own uid — otherwise one request could wipe every like
                    // or add likes in other members' names.
                    || (resource.data.status == 'published'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['likedBy', 'visitorLikes'])
                        && oneLikeStep('likedBy')
                        && oneLikeStep('visitorLikes')
                        && ownLikeOnly());
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && request.auth.uid == resource.data.authorId);
    }

    // ── newsletter_subscribers ────────────────────────────────
    // Anyone can subscribe (src/components/NewsletterForm.tsx). Field-capped
    // and size-bounded for the same reason as contact_messages — a direct
    // SDK write shouldn't be able to smuggle extra fields or oversized
    // strings past the client form. Only curators can read the list.
    match /newsletter_subscribers/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt'])
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.subscribedAt is string;
      allow read, update, delete: if isCurator();
    }

    // ── role_assignments ──────────────────────────────────────
    // Curators create/delete. Ownership is by email match (isAssignee()
    // above) since these docs never carry a `uid` field. The assignee
    // needs read access to their own pending assignment so the client can
    // discover what role to self-apply on first login (src/lib/auth.ts,
    // lookupRoleAssignment) — without it that lookup silently returns
    // nothing and no role, not even shaper/alumni, is ever applied.
    // Deliberately no `update` rule: marking an assignment "joined" for a
    // curator-facing notification is intentionally not supported.
    // Hardened create: the doc id must be the (lowercased) email it grants,
    // the role must be a real one, only the Curator can grant 'curator',
    // and only the fields the Role Assignments page writes are accepted.
    match /role_assignments/{docId} {
      allow read:   if isAssignee(resource.data) || isCuratorOrImpact();
      allow create: if isCurator()
                    && request.resource.data.email is string
                    && request.resource.data.email == docId
                    && docId == docId.lower()
                    && request.resource.data.role in ['curator', 'vice_curator', 'impact_officer', 'shaper', 'alumni']
                    && (request.resource.data.role != 'curator' || isFullCurator())
                    && request.resource.data.keys().hasOnly(
                         ['email', 'displayName', 'role', 'note', 'status', 'createdAt', 'addedBy', 'account', 'joinedAt'])
                    && optStr(request.resource.data, 'displayName', 100)
                    && optStr(request.resource.data, 'note', 300);
      allow delete: if isCurator() || isAssignee(resource.data);
    }

    // ── contact_messages ──────────────────────────────────────
    // Anyone can submit (the reCAPTCHA check on the contact form is
    // client-side only — Firestore rules can't verify a token — so this
    // caps what a direct SDK write can contain instead: no extra/spoofed
    // fields like a pre-set `read:true`, and bounded string sizes so the
    // form can't be used to write arbitrarily large documents). Only
    // curators can read + manage.
    match /contact_messages/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'submittedAt', 'read'])
                    && request.resource.data.read == false
                    && request.resource.data.name is string    && request.resource.data.name.size()    <= 200
                    && request.resource.data.email is string   && request.resource.data.email.size()   <= 254
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.subject is string && request.resource.data.subject.size() <= 300
                    && request.resource.data.message is string && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isCurator();
    }

    // ── activity_responses ───────────────────────────────────
    // Hub Activities' custom-form submissions. Public create (activities
    // are open community events, not member-only, matching
    // contact_messages' precedent for unauthenticated public submissions)
    // — `answers` can't be validated more granularly than "is a map" since
    // each activity's question set is curator-defined and dynamic, unlike
    // contact_messages' fixed fields. Reads are curator/impact-officer
    // only so individual respondents' answers are never publicly listable,
    // only the activity doc itself (which never contains responses) is.
    // `read` starts false (contact_messages' pattern) and update is capped
    // to just that field, so opening the "View Responses" modal can mark
    // them seen without a curator write being able to touch anything else.
    match /activity_responses/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['activityId', 'answers', 'submittedAt', 'submitterName', 'submitterEmail', 'read'])
                    && request.resource.data.activityId is string
                    && request.resource.data.answers is map && request.resource.data.answers.size() <= 50
                    && request.resource.data.submittedAt is string
                    && (!('submitterName' in request.resource.data)  || (request.resource.data.submitterName  is string && request.resource.data.submitterName.size()  <= 200))
                    && (!('submitterEmail' in request.resource.data) || (request.resource.data.submitterEmail is string && request.resource.data.submitterEmail.size() <= 200))
                    && request.resource.data.read == false;
      allow read, delete: if isCuratorOrImpact();
      allow update: if isCuratorOrImpact()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ── media ─────────────────────────────────────────────────
    // One uploaded photo per document (src/lib/media.ts), served publicly
    // by /api/media/<id> — so reads are public, like the initiatives and
    // activities that reference them. Only signed-in members may upload,
    // only as themselves, only a JPEG data URI, and below Firestore's
    // 1 MiB document limit. Documents are immutable once written.
    match /media/{docId} {
      allow read: if true;
      allow create: if isAnyMember()
                    && request.resource.data.keys().hasOnly(['data', 'contentType', 'uploadedBy', 'createdAt'])
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.contentType == 'image/jpeg'
                    && request.resource.data.data is string
                    && request.resource.data.data.size() <= 1000000
                    && request.resource.data.createdAt is string;
      allow delete: if isCurator()
                    || (isSignedIn() && resource.data.uploadedBy == request.auth.uid);
    }

    // ── settings ──
    // Hub-wide switches. Currently only settings/charter
    // { requireSignature }: whether members must sign the Community
    // Charter. Any signed-in member reads it (the dashboard banner);
    // only curators change it, and only those fields.
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isCurator()
                            && docId == 'charter'
                            && request.resource.data.keys().hasOnly(['requireSignature', 'updatedAt', 'updatedBy'])
                            && request.resource.data.requireSignature is bool;
    }

    // ── charter_signatures ──
    // A member's sign-off on the Community Charter, keyed by their uid:
    // their name plus the form's "I confirm compliance with Community
    // Charter". Only the member writes their own (never someone else's);
    // curators and impact officers read everyone's to see who signed, and
    // curators delete them to start a new signing round.
    match /charter_signatures/{uid} {
      allow read: if isOwner(uid) || isCuratorOrImpact();
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['uid', 'name', 'confirmed', 'signedAt'])
                            && request.resource.data.uid == uid
                            && request.resource.data.confirmed == true
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 120
                            && request.resource.data.signedAt is string;
      allow delete: if isCurator();
    }

    // ── notifications ─────────────────────────────────────────
    // Signed-in users can create. Only curators can read and update.
    // Field-capped to the exact shape dashboard/impact/projects writes, so
    // a raw SDK call can't smuggle extra fields into what a curator later
    // reads and trusts.
    // Only the project tools (curators, impact officers) send them, always
    // as themselves and unread, with bounded sizes.
    match /notifications/{docId} {
      allow read, update: if isCurator();
      allow create: if isCuratorOrImpact()
                    && request.resource.data.keys().hasOnly(
                         ['type', 'initiativeId', 'initiativeTitle', 'fromUserId',
                          'fromUserName', 'toEmail', 'message', 'read', 'createdAt'])
                    && request.resource.data.fromUserId == request.auth.uid
                    && isMyName(request.resource.data.fromUserName)
                    && request.resource.data.read == false
                    && optStr(request.resource.data, 'type', 50)
                    && optStr(request.resource.data, 'initiativeId', 128)
                    && optStr(request.resource.data, 'initiativeTitle', 300)
                    && optStr(request.resource.data, 'toEmail', 254)
                    && optStr(request.resource.data, 'message', 1000);
    }

    // ── leave_requests ─────────────────────────────────────────
    // Members request to leave their own initiative.
    // Curators, impact officers, and that specific initiative's leads can
    // manage it — update is scoped to only the `status` field so a lead
    // can't rewrite anything else on the request doc.
    match /leave_requests/{docId} {
      allow create: if isAnyMember() && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['initiativeId', 'initiativeTitle', 'userId', 'userEmail', 'userName', 'status', 'requestedAt'])
                    && isNewRequest(request.resource.data)
                    && isInitiative(request.resource.data.initiativeId)
                    && optStr(request.resource.data, 'initiativeTitle', 300)
                    && isMyEmail(request.resource.data.userEmail)
                    && isMyName(request.resource.data.userName);
      allow read: if isOwner(resource.data.userId)
                  || isCuratorOrImpact()
                  || isLeadOf(resource.data.initiativeId);
      allow update: if isCuratorOrImpact()
                    || (isLeadOf(resource.data.initiativeId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isOwner(resource.data.userId) || isCuratorOrImpact();
    }

    // ── removal_requests ────────────────────────────────────────
    // Initiative leads submit removal requests for members — create
    // requires the caller to actually be a lead of that initiative
    // (otherwise any signed-in member could spam removal requests
    // targeting arbitrary users in initiatives they have no relation to).
    // Curators and impact officers review and approve/decline.
    match /removal_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.requestedByUserId == request.auth.uid
                    && isLeadOf(request.resource.data.initiativeId)
                    && request.resource.data.keys().hasOnly(['initiativeId', 'initiativeTitle', 'targetUserId', 'targetUserName', 'requestedByUserId', 'requestedByName', 'status', 'requestedAt'])
                    && isNewRequest(request.resource.data)
                    && request.resource.data.targetUserId is string
                    && optStr(request.resource.data, 'initiativeTitle', 300)
                    && optStr(request.resource.data, 'targetUserName', 200)
                    && isMyName(request.resource.data.requestedByName);
      allow read: if isCuratorOrImpact()
                  || isOwner(resource.data.requestedByUserId);
      allow update: if isCuratorOrImpact();
      allow delete: if isOwner(resource.data.requestedByUserId) || isCuratorOrImpact();
    }

    // ── member_add_requests ──────────────────────────────────────
    // Mirror of removal_requests: an initiative lead can invite someone
    // who hasn't already submitted their own join_request, but — same as
    // removal — can't unilaterally add them; a curator/impact officer
    // reviews and approves/declines before the target actually lands in
    // the initiative's `members` array.
    match /member_add_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.requestedByUserId == request.auth.uid
                    && isLeadOf(request.resource.data.initiativeId)
                    && request.resource.data.keys().hasOnly(['initiativeId', 'initiativeTitle', 'targetUserId', 'targetUserName', 'requestedByUserId', 'requestedByName', 'status', 'requestedAt'])
                    && isNewRequest(request.resource.data)
                    && request.resource.data.targetUserId is string
                    && optStr(request.resource.data, 'initiativeTitle', 300)
                    && optStr(request.resource.data, 'targetUserName', 200)
                    && isMyName(request.resource.data.requestedByName);
      allow read: if isCuratorOrImpact()
                  || isOwner(resource.data.requestedByUserId);
      allow update: if isCuratorOrImpact();
      allow delete: if isOwner(resource.data.requestedByUserId) || isCuratorOrImpact();
    }
  }
}
