rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Normalize to lowercase so "Curator"/"curator"/"CURATOR" all match.
    function userRole() {
      let raw = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return raw is string ? raw.lower() : '';
    }

    function isCurator() {
      return isSignedIn() && userRole() in ['curator', 'vice_curator', 'vice curator'];
    }

    // Accept both "impact_officer" (underscore) and "impact officer" (space).
    function isImpactOfficer() {
      return isSignedIn() && userRole() in ['impact_officer', 'impact officer'];
    }

    function isCuratorOrImpact() {
      return isCurator() || isImpactOfficer();
    }

    function isShaper() {
      return isSignedIn() && userRole() in ['shaper', 'alumni'];
    }

    function isAnyMember() {
      return isSignedIn() && userRole() in ['curator', 'vice_curator', 'vice curator', 'impact_officer', 'impact officer', 'shaper', 'alumni'];
    }

    // ── users ─────────────────────────────────────────────────
    // Public can read (for About/shapers pages).
    // Users write only their own doc, but may never self-assign a
    // privileged role — only an existing curator can grant
    // curator/vice_curator/impact_officer. This is the only place
    // `role` is ever safe to trust: without this guard any signed-in
    // user could call updateDoc(users/{ownUid}, {role:'curator'})
    // directly via the SDK and grant themselves admin access, since
    // every isCurator()/isImpactOfficer() check in this file reads
    // straight from this field.
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == null
                        || request.resource.data.role in ['shaper', 'alumni']);
      allow update: if isCurator()
                    || (isOwner(uid)
                        && (request.resource.data.role == resource.data.role
                            || request.resource.data.role in ['shaper', 'alumni']));
      allow delete: if isCurator();
    }

    // ── initiatives ───────────────────────────────────────────
    // Public can read. Curators can create/delete. Curators and initiative
    // leads (UIDs in the `leads` array) can update content.
    match /initiatives/{docId} {
      allow read: if true;
      allow create, delete: if isCurator();
      allow update: if isCurator()
                    || (isSignedIn()
                        && 'leads' in resource.data
                        && request.auth.uid in resource.data.leads);
    }

    // ── join_requests ─────────────────────────────────────────
    // Shapers create requests for themselves.
    // Curators, impact officers, and the initiative lead can read + update.
    match /join_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if isOwner(resource.data.userId)
                    || isCuratorOrImpact();
      allow update: if isCuratorOrImpact();
      allow delete: if isOwner(resource.data.userId) || isCuratorOrImpact();
    }

    // ── blogs ─────────────────────────────────────────────────
    // Published posts are publicly readable.
    // Any authenticated member can create (status will be 'draft' or 'pending').
    // Curators can read/write all. Authors can read/edit their own draft/pending.
    match /blogs/{docId} {
      allow read: if resource.data.status == 'published'
                  || (isSignedIn() && (
                       isCuratorOrImpact()
                       || request.auth.uid == resource.data.authorId
                     ));
      // authorId must be the writer's own uid (no impersonation), and only
      // curators/impact officers may create a post already in 'published' —
      // everyone else's direct writes are capped at draft/pending_review
      // regardless of what the client UI offers, since that's a
      // client-only signal with nothing server-side to verify it.
      allow create: if isAnyMember()
                    && request.resource.data.authorId == request.auth.uid
                    && (isCuratorOrImpact()
                        || request.resource.data.status in ['draft', 'pending_review']);
      allow update: if isCuratorOrImpact()
                    || (isSignedIn()
                        && request.auth.uid == resource.data.authorId
                        && resource.data.status in ['draft', 'pending_review'])
                    // Likes: anyone (including anonymous visitors) may toggle only the
                    // likedBy/visitorLikes fields on a published post — needed because
                    // guest likes are written with no Firebase Auth session at all.
                    || (resource.data.status == 'published'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['likedBy', 'visitorLikes']));
      allow delete: if isCuratorOrImpact()
                    || (isSignedIn() && request.auth.uid == resource.data.authorId);
    }

    // ── newsletter_subscribers ────────────────────────────────
    // Anyone can subscribe. Only curators can read the list.
    match /newsletter_subscribers/{docId} {
      allow create: if true;
      allow read, update, delete: if isCurator();
    }

    // ── impact_reports ────────────────────────────────────────
    // Public can read. Impact officers and curators can write.
    match /impact_reports/{docId} {
      allow read: if true;
      allow create, update, delete: if isCuratorOrImpact();
    }

    // ── role_assignments ──────────────────────────────────────
    // Curators create/delete. Assigned user can read and delete their own.
    match /role_assignments/{docId} {
      allow read:   if isOwner(resource.data.uid) || isCurator();
      allow create: if isCurator();
      allow delete: if isCurator() || isOwner(resource.data.uid);
    }

    // ── contact_messages ──────────────────────────────────────
    // Anyone can submit. Only curators can read + manage.
    match /contact_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isCurator();
    }

    // ── blog_likes ────────────────────────────────────────────
    // Any signed-in user can like/unlike. Public can read counts.
    match /blog_likes/{docId} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    // ── blog_comments ─────────────────────────────────────────
    // Public can read. Signed-in users can add. Authors and curators can delete.
    match /blog_comments/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.authorId || isCurator());
    }

    // ── notifications ─────────────────────────────────────────
    // Signed-in users can create. Only curators can read and update.
    match /notifications/{docId} {
      allow read, update: if isCurator();
      allow create: if isSignedIn();
    }

    // ── leave_requests ─────────────────────────────────────────
    // Members request to leave their own initiative.
    // Curators, impact officers, and other members (leads use isAnyMember) can manage.
    match /leave_requests/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isCuratorOrImpact() || isAnyMember();
      allow update: if isCuratorOrImpact() || isAnyMember();
      allow delete: if isOwner(resource.data.userId) || isCuratorOrImpact();
    }

    // ── removal_requests ────────────────────────────────────────
    // Initiative leads submit removal requests for members.
    // Curators and impact officers review and approve/decline.
    match /removal_requests/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.requestedByUserId == request.auth.uid;
      allow read: if isCuratorOrImpact()
                  || isOwner(resource.data.requestedByUserId);
      allow update: if isCuratorOrImpact();
      allow delete: if isOwner(resource.data.requestedByUserId) || isCuratorOrImpact();
    }
  }
}
